# ===========================================
# Deep Search Pro - 环境变量配置模板
# ===========================================

# ---------- RAGFlow 知识库服务 ----------
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# ---------- LLM 大模型配置 ----------
# 使用 OpenAI 兼容协议，可接入百度千帆大模型或其他
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 模型名称（可供主agent选择，本项目中主Agent和三个子Agent用的是同一个模型）
LLM_QWEN2.5=
LLM_QWEN3=
LLM_QWEN_MAX=
LLM_QWEN3.5=

# ---------- Tavily 网络搜索 ----------
# 注册地址: https://tavily.com
TAVILY_API_KEY=

# ---------- Agent 查询业务数据库 ----------
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_HOST=
MYSQL_PORT=


# ----------工作台文件元数据数据库----------
APP_MYSQL_USER=
APP_MYSQL_PASSWORD=
APP_MYSQL_DATABASE=
APP_MYSQL_HOST=
APP_MYSQL_PORT=


# ----------MinIO(docker拉起)文件存储----------
# endpoint 只写 host:port，不要加 http://
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false

# 预签名下载地址有效期，600秒=10分钟
MINIO_DOWNLOAD_EXPIRES_SECONDS=600

# ----------本地临时工作区----------
# 清理超过24小时的异常残留目录
WORKSPACE_MAX_AGE_HOURS=24