# 使用同一服务平台的模型、地址与 Key。
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=replace-me
LLM_MODEL=your-model-id

# 可选：未配置的助手不注册。
TAVILY_API_KEY=
RAGFLOW_API_URL=
RAGFLOW_API_KEY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 默认仅允许本地前端 dev/preview 来源。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# 默认关闭以使用稳定的单进程；仅开发热重载时改为 true。
BACKEND_RELOAD=false

# 工作台文件元数据数据库（与 Agent 查询的 MYSQL_* 保持独立连接）
APP_MYSQL_HOST=localhost
APP_MYSQL_PORT=3306
APP_MYSQL_USER=root
APP_MYSQL_PASSWORD=replace-me
APP_MYSQL_DATABASE=deep_search_workbench

# MinIO 永久文件存储
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=deep-search-files
MINIO_SECURE=false
MINIO_DOWNLOAD_EXPIRES_SECONDS=600

# output/updated 下异常遗留会话目录的最长保留时间
WORKSPACE_MAX_AGE_HOURS=24
