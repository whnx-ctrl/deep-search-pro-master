# Compose 对宿主机开放的端口
FRONTEND_PORT=5173
BACKEND_PORT=8000
LOCAL_MYSQL_PORT=3307
LOCAL_MINIO_API_PORT=9010
LOCAL_MINIO_CONSOLE_PORT=9011

# 仅用于个人本地 Compose；共享或联网部署时必须改成随机强密码。
LOCAL_MYSQL_ROOT_PASSWORD=deep-search-root-local
LOCAL_MYSQL_USER=deepsearch
LOCAL_MYSQL_PASSWORD=deep-search-local
LOCAL_MYSQL_DATABASE=deep_search_workbench

LOCAL_MINIO_ACCESS_KEY=minioadmin
LOCAL_MINIO_SECRET_KEY=minioadmin-local
LOCAL_MINIO_BUCKET=deep-search-files
